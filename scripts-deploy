const hre = require("hardhat");
async function main() {
  const [a,b,c] = await hre.ethers.getSigners();
  const payees = [a.address, b.address, c.address];
  const shares = [50, 30, 20];

  const Splitter = await hre.ethers.getContractFactory("RevenueSplitter");
  const splitter = await Splitter.deploy(payees, shares, { value: hre.ethers.parseEther("0.1") });
  await splitter.deployed();
  console.log("RevenueSplitter at:", splitter.target);
}
main().catch((e)=>{ console.error(e); process.exit(1); });
